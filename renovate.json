{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Gradle"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker"
    }
  ]
}
